{
  "name": "novel-atlas",
  "version": "2.0.6",
  "private": true,
  "description": "织灵 · 小说角色关系网",
  "author": "Novel Atlas",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "test": "vitest run",
    "start": "node server/start.cjs",
    "pack": "node node_modules/electron/install.js && npm run build && electron-builder --win portable --x64 --publish never",
    "pack:release": "node node_modules/electron/install.js && npm run build && electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "cytoscape": "^3.33.1",
    "cytoscape-fcose": "^2.2.0",
    "lucide-vue-next": "^0.577.0",
    "vue": "3.5.30"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "electron": "44.4.1",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.novelatlas.desktop",
    "productName": "织灵",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/store.cjs",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "织灵.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "织灵（桌面版）",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "artifactName": "织灵-安装程序-${version}.exe"
    }
  }
}
